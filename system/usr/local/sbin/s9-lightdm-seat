#!/bin/sh

LOG=/var/log/s9-lightdm-seat.log
exec >>"$LOG" 2>&1

export XCURSOR_THEME=DMZ-Black
export XCURSOR_SIZE=64

echo
echo "============================================================"
echo "S9 LIGHTDM EXISTING X SEAT"
date
echo "pid=$$"
echo "DISPLAY=${DISPLAY:-<VAZIO>}"
echo "============================================================"

if [ -z "${DISPLAY:-}" ]; then
    echo "ERRO: DISPLAY nao definido"
    exit 40
fi

DNUM="${DISPLAY#:}"
DNUM="${DNUM%%.*}"

echo "DISPLAY NUMBER=$DNUM"

if command -v xhost >/dev/null 2>&1; then
    xhost +SI:localuser:lightdm || true
    xhost +SI:localuser:@S9_USER@ || true
fi

echo "===== DISPLAY HOTPLUG WATCH ====="

pkill -f "/usr/local/sbin/s9-display-watch" 2>/dev/null || true

nohup /usr/local/sbin/s9-display-watch \
    >/dev/null 2>&1 </dev/null &

#
# Deixa o watcher observar o estado inicial.
#
sleep 2

echo "===== OVERRIDE POINTER ====="

pkill -f "/usr/local/sbin/s9-visible-pointer" 2>/dev/null || true

nohup /usr/local/sbin/s9-visible-pointer \
    >>/var/log/s9-visible-pointer.log \
    2>&1 </dev/null &

echo "===== ESPERANDO LIGHTDM ====="

i=0

while ! dm-tool list-seats >/dev/null 2>&1; do

    i=$((i + 1))

    if [ "$i" -gt 30 ]; then
        echo "ERRO: LightDM nao apareceu"
        exit 41
    fi

    sleep 1
done

echo "===== LIGHTDM OK ====="

SEAT="$(dm-tool add-local-x-seat "$DNUM" 2>&1)"
RC=$?

echo "$SEAT"
echo "rc=$RC"

exit "$RC"
