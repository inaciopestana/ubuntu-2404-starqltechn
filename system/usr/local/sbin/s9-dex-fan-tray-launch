#!/usr/bin/env bash
# Espera o painel do usuario e executa a bandeja com o ambiente grafico dele.
U=@S9_USER@
PID=
for i in $(seq 1 240); do
  PID=$(pgrep -u $U -x xfce4-panel | head -1)
  [ -n "$PID" ] && [ -r "/proc/$PID/environ" ] && break
  PID=
  sleep 1
done
[ -n "$PID" ] || { echo "painel nao encontrado em 240 s"; exit 1; }
mapfile -t ENVA < <(tr '\0' '\n' < "/proc/$PID/environ" | grep -E '^(DBUS_SESSION_BUS_ADDRESS|DISPLAY|XAUTHORITY|WAYLAND_DISPLAY|GDK_BACKEND|XDG_CURRENT_DESKTOP|XDG_SESSION_TYPE)=')
exec runuser -u $U -- env HOME=/home/$U XDG_RUNTIME_DIR=/run/user/1000 "${ENVA[@]}" /usr/local/bin/s9-dex-fan-tray
