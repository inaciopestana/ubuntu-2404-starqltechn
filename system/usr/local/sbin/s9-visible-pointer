#!/usr/bin/python3

import ctypes
import signal
import sys
import time

X = ctypes.CDLL("libX11.so.6")

Display = ctypes.c_void_p
Window = ctypes.c_ulong

class XSetWindowAttributes(ctypes.Structure):
    _fields_ = [
        ("background_pixmap", ctypes.c_ulong),
        ("background_pixel", ctypes.c_ulong),
        ("border_pixmap", ctypes.c_ulong),
        ("border_pixel", ctypes.c_ulong),
        ("bit_gravity", ctypes.c_int),
        ("win_gravity", ctypes.c_int),
        ("backing_store", ctypes.c_int),
        ("backing_planes", ctypes.c_ulong),
        ("backing_pixel", ctypes.c_ulong),
        ("save_under", ctypes.c_int),
        ("event_mask", ctypes.c_long),
        ("do_not_propagate_mask", ctypes.c_long),
        ("override_redirect", ctypes.c_int),
        ("colormap", ctypes.c_ulong),
        ("cursor", ctypes.c_ulong),
    ]

X.XOpenDisplay.argtypes = [ctypes.c_char_p]
X.XOpenDisplay.restype = Display

X.XDefaultScreen.argtypes = [Display]
X.XDefaultScreen.restype = ctypes.c_int

X.XRootWindow.argtypes = [Display, ctypes.c_int]
X.XRootWindow.restype = Window

X.XBlackPixel.argtypes = [Display, ctypes.c_int]
X.XBlackPixel.restype = ctypes.c_ulong

X.XWhitePixel.argtypes = [Display, ctypes.c_int]
X.XWhitePixel.restype = ctypes.c_ulong

X.XCreateSimpleWindow.argtypes = [
    Display, Window,
    ctypes.c_int, ctypes.c_int,
    ctypes.c_uint, ctypes.c_uint,
    ctypes.c_uint,
    ctypes.c_ulong, ctypes.c_ulong
]
X.XCreateSimpleWindow.restype = Window

X.XChangeWindowAttributes.argtypes = [
    Display, Window, ctypes.c_ulong,
    ctypes.POINTER(XSetWindowAttributes)
]

X.XMapRaised.argtypes = [Display, Window]
X.XMoveWindow.argtypes = [Display, Window, ctypes.c_int, ctypes.c_int]
X.XRaiseWindow.argtypes = [Display, Window]
X.XFlush.argtypes = [Display]

X.XQueryPointer.argtypes = [
    Display, Window,
    ctypes.POINTER(Window),
    ctypes.POINTER(Window),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_uint),
]
X.XQueryPointer.restype = ctypes.c_int

print("S9 OVERRIDE POINTER START", flush=True)

dpy = None

for i in range(100):
    dpy = X.XOpenDisplay(None)
    if dpy:
        break
    time.sleep(0.1)

if not dpy:
    print("ERRO: XOpenDisplay", flush=True)
    sys.exit(1)

screen = X.XDefaultScreen(dpy)
root = X.XRootWindow(dpy, screen)

black = X.XBlackPixel(dpy, screen)
white = X.XWhitePixel(dpy, screen)

win = X.XCreateSimpleWindow(
    dpy,
    root,
    -100, -100,
    24, 24,
    3,
    white,
    black
)

attrs = XSetWindowAttributes()
attrs.override_redirect = 1
attrs.save_under = 1

CWOverrideRedirect = 1 << 9
CWSaveUnder = 1 << 10

X.XChangeWindowAttributes(
    dpy,
    win,
    CWOverrideRedirect | CWSaveUnder,
    ctypes.byref(attrs)
)

#
# Se XFixes estiver disponível, deixa a janela completamente
# transparente a input: clique passa através dela.
#
try:
    XF = ctypes.CDLL("libXfixes.so.3")

    XF.XFixesCreateRegion.argtypes = [
        Display,
        ctypes.c_void_p,
        ctypes.c_int
    ]
    XF.XFixesCreateRegion.restype = ctypes.c_ulong

    XF.XFixesSetWindowShapeRegion.argtypes = [
        Display,
        Window,
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_int,
        ctypes.c_ulong
    ]

    ShapeInput = 2

    empty = XF.XFixesCreateRegion(dpy, None, 0)

    XF.XFixesSetWindowShapeRegion(
        dpy,
        win,
        ShapeInput,
        0, 0,
        empty
    )

    print("input shape vazia OK", flush=True)

except Exception as e:
    print("XFixes indisponivel:", e, flush=True)

X.XMapRaised(dpy, win)
X.XFlush(dpy)

print("override pointer criado", flush=True)

running = True

def stop(*_):
    global running
    running = False

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

root_ret = Window()
child_ret = Window()

rx = ctypes.c_int()
ry = ctypes.c_int()
wx = ctypes.c_int()
wy = ctypes.c_int()
mask = ctypes.c_uint()

while running:

    ok = X.XQueryPointer(
        dpy,
        root,
        ctypes.byref(root_ret),
        ctypes.byref(child_ret),
        ctypes.byref(rx),
        ctypes.byref(ry),
        ctypes.byref(wx),
        ctypes.byref(wy),
        ctypes.byref(mask)
    )

    if ok:
        X.XMoveWindow(
            dpy,
            win,
            rx.value + 18,
            ry.value + 18
        )

        X.XRaiseWindow(dpy, win)
        X.XFlush(dpy)

    time.sleep(0.01)
