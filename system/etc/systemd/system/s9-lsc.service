[Unit]
Description=Galaxy S9 Lomiri System Compositor
Requires=lxc-android-config.service s9-gpu-permissions.service
After=lxc-android-config.service s9-gpu-permissions.service
Conflicts=lightdm.service display-manager.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 100 ]; do [ -e /dev/kgsl-3d0 ] && [ -e /dev/ion ] && exit 0; i=$((i+1)); sleep 0.1; done; exit 1'
ExecStart=/usr/local/sbin/s9-lsc-wrapper
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
