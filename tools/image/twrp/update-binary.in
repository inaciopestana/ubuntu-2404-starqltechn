#!/sbin/sh
# TWRP installer generated by tools/image/build-image.sh  (mode: @MODE@)
#
# Writes two things and nothing else:
#   * the Ubuntu root image into the userdata partition (sda29), 1 MiB from its start
#   * the boot image into the boot partition (sda20)
# Android's data on userdata is DESTROYED. It never touches system, vendor, modem, efs,
# persist, dtbo or vbmeta. The root image is written first and read back; boot is replaced
# only after that check passes.
#
# Test hooks (never set by TWRP): S9_TEST=1 S9_TEST_BOOT=<file> S9_TEST_DATA=<file>

OUTFD="${2:-}"
ZIPFILE="${3:-}"
PATH=/sbin:/system/bin:/system/xbin:$PATH
export PATH

BOOT_SIZE=@BOOT_SIZE@
BOOT_SHA256=@BOOT_SHA256@
RAW_SIZE=@RAW_SIZE@
RAW_SHA256=@RAW_SHA256@
PARTS="@PARTS@"
BOOT_ENTRY=payload/boot.img
MIB=1048576
WROTE=0

ui_print() { printf 'ui_print %s\nui_print\n' "$*" >&"$OUTFD"; }
set_progress() { printf 'set_progress %s\n' "$1" >&"$OUTFD"; }
abort_install() {
  ui_print ""
  ui_print "ERROR: $*"
  if [ "$WROTE" = 0 ]; then ui_print "Nothing was written to the phone."
  else ui_print "The root image may be incomplete: do NOT reboot into Ubuntu. Flash a known-good package."; fi
  exit 1
}

[ -n "$OUTFD" ] || exit 2
[ -f "$ZIPFILE" ] || abort_install "TWRP did not give the path of the ZIP."
TOOLS="unzip xz sha256sum dd head wc sync"
[ "${S9_TEST:-}" = 1 ] || TOOLS="$TOOLS grep umount readlink blockdev getprop"
for T in $TOOLS; do
  command -v "$T" >/dev/null 2>&1 || abort_install "tool missing in this recovery: $T"
done

ui_print "========================================"
ui_print " Galaxy S9 Ubuntu - TWRP installer ($(printf %s '@MODE@'))"
ui_print "========================================"

if [ "${S9_TEST:-}" = 1 ]; then
  BOOT_BLOCK=$S9_TEST_BOOT; DATA_BLOCK=$S9_TEST_DATA
  BOOT_PART_SIZE=$(wc -c < "$BOOT_BLOCK"); DATA_PART_SIZE=$(wc -c < "$DATA_BLOCK")
else
  DEVICE="$(getprop ro.product.device)"; [ -n "$DEVICE" ] || DEVICE="$(getprop ro.build.product)"
  MODEL="$(getprop ro.product.model)"
  ui_print "Device: ${DEVICE:-unknown}   Model: ${MODEL:-unknown}"
  case "$DEVICE:$MODEL" in
    starqltechn:*|*:SM-G9600*) ;;
    *) abort_install "this package is only for the Galaxy S9 SM-G9600 (starqltechn).";;
  esac
  find_partition() {
    for C in "/dev/block/platform/soc/1d84000.ufshc/by-name/$1" "/dev/block/bootdevice/by-name/$1" "/dev/block/by-name/$1"; do
      [ -b "$C" ] && { readlink -f "$C"; return 0; }
    done
    return 1
  }
  BOOT_BLOCK="$(find_partition boot)" || abort_install "boot partition not found."
  DATA_BLOCK="$(find_partition userdata)" || abort_install "userdata partition not found."
  # the initramfs of this port hard-codes sda29 as the root container
  [ "$BOOT_BLOCK" = /dev/block/sda20 ] || abort_install "boot is $BOOT_BLOCK, expected /dev/block/sda20."
  [ "$DATA_BLOCK" = /dev/block/sda29 ] || abort_install "userdata is $DATA_BLOCK, expected /dev/block/sda29."
  BOOT_PART_SIZE="$(blockdev --getsize64 "$BOOT_BLOCK" 2>/dev/null)" || abort_install "cannot read the size of boot."
  DATA_PART_SIZE="$(blockdev --getsize64 "$DATA_BLOCK" 2>/dev/null)" || abort_install "cannot read the size of userdata."
fi
ui_print "boot: $BOOT_BLOCK   userdata: $DATA_BLOCK"
[ "$BOOT_PART_SIZE" -ge "$BOOT_SIZE" ] || abort_install "boot partition is smaller than the boot image."
# busybox [ compares integers with 32 bits (userdata is ~57 GB): do the 64-bit comparison inside $(( ))
[ "$((DATA_PART_SIZE >= RAW_SIZE + 2 * MIB))" = 1 ] || abort_install "userdata is too small for the root image."
set_progress 0.02

if [ "${S9_TEST:-}" != 1 ]; then
  # The package overwrites userdata, so it must not be read from the internal storage.
  ZREAL="$(readlink -f "$ZIPFILE" 2>/dev/null)"; [ -n "$ZREAL" ] || ZREAL="$ZIPFILE"
  case "$ZREAL" in
    /data/*|/sdcard/*|/storage/emulated/*|/data/media/*|/sdcard) NOTSD=1;;
    *) NOTSD=0;;
  esac
  BEST=""; BESTDEV=""
  while read -r DEV MP REST; do
    case "$ZREAL" in "$MP"|"$MP"/*) if [ "${#MP}" -gt "${#BEST}" ]; then BEST="$MP"; BESTDEV="$DEV"; fi;; esac
  done < /proc/mounts
  ZDEV="$(readlink -f "$BESTDEV" 2>/dev/null)"; [ -n "$ZDEV" ] || ZDEV="$BESTDEV"
  if [ "$NOTSD" = 1 ] || [ "$ZDEV" = "$DATA_BLOCK" ]; then
    abort_install "the ZIP is on the internal storage (userdata), which this package overwrites. Copy it to the SD card or a USB drive and flash it from there."
  fi
  ui_print "ZIP location: $ZREAL (device $ZDEV)"
  # Unmount everything TWRP mounted from userdata (/data, /sdcard, ...).
  N=0
  while [ "$N" -lt 6 ]; do
    FOUND=0
    while read -r DEV MP REST; do
      REAL="$(readlink -f "$DEV" 2>/dev/null)"; [ -n "$REAL" ] || REAL="$DEV"
      if [ "$REAL" = "$DATA_BLOCK" ]; then FOUND=1; umount "$MP" 2>/dev/null; fi
    done < /proc/mounts
    [ "$FOUND" = 0 ] && break
    N=$((N + 1))
  done
  while read -r DEV MP REST; do
    REAL="$(readlink -f "$DEV" 2>/dev/null)"; [ -n "$REAL" ] || REAL="$DEV"
    [ "$REAL" != "$DATA_BLOCK" ] || abort_install "userdata is still mounted at $MP."
  done < /proc/mounts
fi

TMPDIR=/tmp/s9-install
rm -rf "$TMPDIR"; mkdir -p "$TMPDIR" || abort_install "cannot create $TMPDIR."

ui_print "Checking the ZIP..."
# the busybox unzip of TWRP has no -t: check that the ZIP directory can be read. The payload itself is verified below
# (boot.img SHA-256, xz integrity of the whole root image, SHA-256 read-back of userdata).
unzip -l "$ZIPFILE" >/dev/null 2>&1 || abort_install "the ZIP is corrupt or incomplete (copy it again)."
set_progress 0.06

ui_print "Checking boot.img..."
unzip -p "$ZIPFILE" "$BOOT_ENTRY" > "$TMPDIR/boot.img" || abort_install "cannot extract boot.img."
[ "$(wc -c < "$TMPDIR/boot.img")" -eq "$BOOT_SIZE" ] || abort_install "boot.img has the wrong size."
H="$(sha256sum "$TMPDIR/boot.img")"; H="${H%% *}"
[ "$H" = "$BOOT_SHA256" ] || abort_install "boot.img has the wrong SHA-256."
set_progress 0.08

ui_print "Testing the compressed root image..."
( for P in $PARTS; do unzip -p "$ZIPFILE" "payload/$P" || exit 1; done ) | xz -dc > /dev/null \
  || abort_install "the compressed root image is damaged."
set_progress 0.20

ui_print ""
ui_print "Writing the root image to userdata (several minutes)..."
sync
WROTE=1
( for P in $PARTS; do unzip -p "$ZIPFILE" "payload/$P" || exit 1; done ) | xz -dc \
  | dd of="$DATA_BLOCK" bs=$MIB seek=1 || abort_install "writing userdata failed."
sync
set_progress 0.70

ui_print "Reading it back to verify..."
H="$(dd if="$DATA_BLOCK" bs=$MIB skip=1 count=$((RAW_SIZE / MIB)) 2>/dev/null | sha256sum)"; H="${H%% *}"
[ "$H" = "$RAW_SHA256" ] || abort_install "userdata does not match the image (SHA-256)."
set_progress 0.92

ui_print "Root image verified. Writing boot..."
dd if="$TMPDIR/boot.img" of="$BOOT_BLOCK" bs=4096 2>/dev/null || abort_install "writing boot failed."
sync
H="$(head -c "$BOOT_SIZE" "$BOOT_BLOCK" | sha256sum)"; H="${H%% *}"
[ "$H" = "$BOOT_SHA256" ] || abort_install "boot does not match after writing (SHA-256)."
rm -rf "$TMPDIR"
set_progress 1.00

ui_print ""
ui_print "========================================"
ui_print " DONE - root image and boot verified"
ui_print "========================================"
ui_print "Reboot to system. system, vendor, modem, efs untouched."
