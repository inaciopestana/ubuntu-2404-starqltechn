#!/bin/bash
# s9-install-chrome - install Google Chrome (arm64) from Google's permanent download link.
# Chrome is not part of the image (it is not ours to redistribute), so the first boot fetches it.
# The service that runs this script retries every 5 minutes until the phone is online and gives up
# after 12 failed attempts (counter in /var/lib/s9-ubports/chrome-attempts).
# Log: /var/log/s9-install-chrome.log      Run it by hand with:  sudo s9-install-chrome --force
set -u
URL=https://dl.google.com/linux/direct/google-chrome-stable_current_arm64.deb
DEB=/var/tmp/google-chrome-stable_current_arm64.deb
STATE=/var/lib/s9-ubports/chrome-attempts
mkdir -p "$(dirname "$STATE")"
exec >>/var/log/s9-install-chrome.log 2>&1
echo "== s9-install-chrome $(date -Is)"
[ "${1:-}" = "--force" ] && rm -f "$STATE"
if dpkg -s google-chrome-stable >/dev/null 2>&1; then echo "already installed"; exit 0; fi
N=$(cat "$STATE" 2>/dev/null || echo 0)
if [ "$N" -ge 12 ]; then echo "gave up after $N attempts; run: sudo s9-install-chrome --force"; exit 0; fi
echo $((N + 1)) > "$STATE"

rm -f "$DEB"
if command -v curl >/dev/null; then
  curl -fL --retry 3 --connect-timeout 20 --max-time 1800 -o "$DEB" "$URL" || { echo "download failed (no network?)"; rm -f "$DEB"; exit 1; }
else
  wget -q --tries=3 --timeout=60 -O "$DEB" "$URL" || { echo "download failed (no network?)"; rm -f "$DEB"; exit 1; }
fi
PKG=$(dpkg-deb -f "$DEB" Package 2>/dev/null); ARCH=$(dpkg-deb -f "$DEB" Architecture 2>/dev/null)
if [ "$PKG" != google-chrome-stable ] || [ "$ARCH" != arm64 ]; then
  echo "unexpected download (package '$PKG', architecture '$ARCH')"; rm -f "$DEB"; exit 1
fi
export DEBIAN_FRONTEND=noninteractive
apt-get install -y "$DEB" || { echo "apt-get install failed"; rm -f "$DEB"; exit 1; }
rm -f "$DEB"
echo "Chrome installed: $(google-chrome-stable --version 2>/dev/null)"
