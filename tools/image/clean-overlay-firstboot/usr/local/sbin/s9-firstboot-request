#!/usr/bin/python3
"""s9-firstboot-request - root helper called by the first-boot wizard through sudo.

Reads {"user":..., "password":..., "hostname":...} as JSON on stdin, checks every field again, turns the password into a
crypt hash right away (the clear text is never written anywhere), stores the request root-only and starts
s9-firstboot-apply.service. Works only during the first boot and only for the placeholder account.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.environ.get('S9_FIRSTBOOT_LIB', '/usr/local/lib/s9-firstboot'))
import s9fb  # noqa: E402

TEST = os.environ.get('S9_FIRSTBOOT_TEST') == '1'


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


if os.geteuid() != 0 and not TEST:
    fail('must run as root (through sudo)', 126)
if not TEST and os.environ.get('SUDO_USER') != s9fb.PLACEHOLDER:
    fail('only the first-boot account may call this helper', 126)
if os.path.exists(s9fb.path(s9fb.MARKER)):
    fail('the first-boot setup was already done')
if os.path.exists(s9fb.path(s9fb.REQUEST)):
    fail('a setup request is already being applied')
try:
    req = json.load(sys.stdin)
    user, host, pw = str(req['user']), str(req['hostname']).lower(), str(req['password'])
except (ValueError, KeyError, TypeError):
    fail('bad request')
err = s9fb.check_user(user) or s9fb.check_host(host) or s9fb.check_password(pw)
if err:
    fail(err)
h = subprocess.run(['openssl', 'passwd', '-6', '-stdin'], input=pw.encode(), capture_output=True)
pw = ''
hashed = h.stdout.decode().strip()
if h.returncode != 0 or not hashed.startswith('$6$'):
    fail('could not hash the password')
os.makedirs(s9fb.path(s9fb.STATE_DIR), mode=0o755, exist_ok=True)
try:
    os.unlink(s9fb.path(s9fb.ERROR_FILE))
except OSError:
    pass
fd = os.open(s9fb.path(s9fb.REQUEST), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, 'w') as f:
    json.dump({'user': user, 'hash': hashed, 'hostname': host}, f)
if os.environ.get('S9_FIRSTBOOT_NO_SYSTEMD') != '1':
    r = subprocess.run(['systemctl', 'start', '--no-block', 's9-firstboot-apply.service'])
    if r.returncode != 0:
        os.unlink(s9fb.path(s9fb.REQUEST))
        fail('could not start the setup service')
print('ok')
