+// Context-aware GL texture cleanup, ported from the validated V7.
+namespace
+{
+struct PendingTextureDeletion
+{
+    EGLDisplay display;
+    EGLContext context;
+    GLuint texture;
+};
+
+std::mutex pending_texture_mutex;
+std::vector<PendingTextureDeletion> pending_textures;
+
+void delete_texture_in_current_context(GLuint texture)
+{
+    if (glIsTexture(texture) == GL_TRUE)
+        glDeleteTextures(1, &texture);
+}
+
+void flush_pending_texture_deletions()
+{
+    auto const display = eglGetCurrentDisplay();
+    auto const context = eglGetCurrentContext();
+
+    if (display == EGL_NO_DISPLAY ||
+        context == EGL_NO_CONTEXT)
+        return;
+
+    std::vector<PendingTextureDeletion> ready;
+
+    {
+        std::lock_guard<std::mutex> lock(pending_texture_mutex);
+        auto it = pending_textures.begin();
+
+        while (it != pending_textures.end())
+        {
+            if (it->display == display &&
+                it->context == context)
+            {
+                ready.push_back(*it);
+                it = pending_textures.erase(it);
+            }
+            else
+                ++it;
+        }
+    }
+
+    for (auto const& item : ready)
+        delete_texture_in_current_context(item.texture);
+}
+
+void release_owned_texture(
+    GLuint texture,
+    EGLDisplay owner_display,
+    EGLContext owner_context)
+{
+    if (texture == 0)
+        return;
+
+    if (owner_display != EGL_NO_DISPLAY &&
+        owner_context != EGL_NO_CONTEXT &&
+        eglGetCurrentDisplay() == owner_display &&
+        eglGetCurrentContext() == owner_context)
+    {
+        delete_texture_in_current_context(texture);
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(pending_texture_mutex);
+    pending_textures.push_back({
+        owner_display, owner_context, texture
+    });
+}
+}
