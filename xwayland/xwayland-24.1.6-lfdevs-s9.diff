+static Bool
+xwl_glamor_kgsl_surfaceless_init_egl(struct xwl_screen *xwl_screen)
+{
+    struct xwl_gbm_private *xwl_gbm = xwl_gbm_get(xwl_screen);
+    EGLint major, minor;
+    const char *egl_vendor;
+
+    if (!xwl_screen->dmabuf) {
+        ErrorF("Xwayland glamor: KGSL surfaceless requires linux-dmabuf\n");
+        return FALSE;
+    }
+
+    xwl_gbm->backend = XWL_GLAMOR_BACKEND_KGSL_SURFACELESS;
+    xwl_screen->egl_display =
