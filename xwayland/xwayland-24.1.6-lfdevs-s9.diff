+Bool
+xwl_glamor_is_kgsl_surfaceless(struct xwl_screen *xwl_screen)
+{
+    struct xwl_gbm_private *xwl_gbm;
+
+    /* The private key is only registered when xwl_glamor_init_gbm() got far
+     * enough; dixLookupPrivate() asserts on an unregistered key. */
+    if (!xwl_gbm_private_key.initialized)
+        return FALSE;
+
+    xwl_gbm = xwl_gbm_get(xwl_screen);
+    return xwl_gbm &&
+        xwl_gbm->backend == XWL_GLAMOR_BACKEND_KGSL_SURFACELESS;
+}
