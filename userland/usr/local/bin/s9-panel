        self.w_sec = label('Cast screen to:', 'sec')
        self.w_list = TargetList(self.wifi_pick)
        self.w_none = label('', 'dim')
        self.w_search = button('Search for displays again', None, lambda x: self.cast.wscan_maybe(True))
        self.w_q = Seg([('normal', 'Normal (1080p if supported)'), ('light', 'Light (720p)')],
                       lambda v: self.cast.act('Setting quality', 'quality', v))
        for w in (self.w_l1, self.w_busy, self.w_stop, self.w_sec, self.w_list, self.w_none, self.w_search,
                  label('Quality', 'sec'), self.w_q):
            b.pack_start(w, False, False, 0)
        return scrolled(b)

    def wifi_pick(self, tid):
        c = self.cast
        if c.won() and c.st.get('target_id') == tid:
            c.act('Stopping screen cast', 'stop')
        else:
            t = next((x for x in c.wtargets if x['id'] == tid), {'name': 'display'})
            c.act('Connecting to ' + t['name'][:28], 'wifi', tid)

    def update_wifi(self):
        c, cs = self.cast, self.cast.st
        won, cbusy = c.won(), bool(c.busy)
        self.w_l1.set_text(c.wline1())
        self.w_busy.set_text((c.busy or '') + '...'); vis(self.w_busy, cbusy)
        vis(self.w_stop, won and not cbusy)
        self.w_list.fill([(t['id'], t['name'][:32], won and cs.get('target_id') == t['id']) for t in c.wtargets], not cbusy)
        self.w_none.set_text('Searching for displays...' if c.wscanning else 'No Wi-Fi displays found')
        vis(self.w_none, c.wscanning or not c.wtargets)
        vis(self.w_search, (not won) and (not cbusy) and (not c.wscanning))
        self.w_q.set_value(cs.get('quality', 'normal'), not cbusy)

    # ---------------------------------------------------------- Mobile Data
    def build_data(self):
        b = page_box()
        self.m_l1 = label('', 'h1', wrap=True); self.m_l2 = label('', 'dim', wrap=True); self.m_busy = label('', 'dim')
        m = self.mob
        self.m_btn = {}
        spec = [('off', 'Turn data off', ('Turning data off', 'down')),
                ('prim', 'Use SIM as primary connection', ('Switching to primary', 'up', 'primary')),
                ('back', 'Use SIM as Wi-Fi backup', ('Switching to backup', 'up', 'backup')),
                ('on_b', 'Turn data on (Wi-Fi backup)', ('Turning data on', 'up', 'backup')),
                ('on_p', 'Turn data on (primary)', ('Turning data on', 'up', 'primary')),
                ('pon', 'Power on modem (register only)', ('Powering on modem', 'on')),
                ('poff', 'Power off modem (stop ofono)', ('Powering off modem', 'off'))]
        for w in (self.m_l1, self.m_l2, self.m_busy):
            b.pack_start(w, False, False, 0)
        for key, text, args in spec:
            btn = button(text, None, lambda x, a=args: self.mob.act(*a))
            self.m_btn[key] = btn
            b.pack_start(btn, False, False, 0)
        return scrolled(b)

    def update_data(self):
        m = self.mob; st = m.st
        on, data, online, busy = st.get('state') == 'on', st.get('data') == 'true', st.get('online') == 'true', bool(m.busy)
        self.m_l1.set_text(m.line1()); self.m_l2.set_text(m.line2())
        self.m_busy.set_text((m.busy or '') + '...'); vis(self.m_busy, busy)
        vis(self.m_btn['off'], data and not busy); vis(self.m_btn['prim'], data and not busy)
        vis(self.m_btn['back'], data and not busy)
        vis(self.m_btn['on_b'], (not data) and not busy); vis(self.m_btn['on_p'], (not data) and not busy)
        vis(self.m_btn['pon'], (not online) and not busy); vis(self.m_btn['poff'], on and not busy)

    # ---------------------------------------------------------- DexStation Fan
    def build_fan(self):
        b = page_box()
        self.f_l1 = label('', 'h1', wrap=True); self.f_l2 = label('', 'dim', wrap=True); self.f_busy = label('', 'dim')
        self.f_seg = Seg([(k, t) for k, t in Fan.MODES], lambda v: self.fan.act(v))
        self.f_note = label('Auto raises the speed by CPU/GPU temperature. The dock does not report RPM; confirm by sound.',
                            'dim', wrap=True)
        for w in (self.f_l1, self.f_l2, self.f_busy, self.f_seg, self.f_note):
            b.pack_start(w, False, False, 0)
        return scrolled(b)

    def update_fan(self):
        f = self.fan; st = f.st
        self.f_l1.set_text(('Fan: %s' % dict(Fan.MODES).get(st.get('mode', ''), st.get('mode') or '?')) if st else 'Reading...')
        parts = []
        if st.get('temp'): parts.append('%s °C (max CPU/GPU)' % st['temp'])
        if st: parts.append('Dock connected' if st.get('dock_ok') else 'Dock not detected (the setting is kept for when it is attached)')
        self.f_l2.set_text(' · '.join(parts))
        self.f_busy.set_text('Applying %s...' % f.busy if f.busy else ''); vis(self.f_busy, bool(f.busy))
        self.f_seg.set_value(st.get('mode') if st.get('mode') in dict(Fan.MODES) else None, not f.busy)

    # ---------------------------------------------------------- atualizacao geral
    def update_all(self):
        c, m, f = self.cast, self.mob, self.fan
        try:
            self.tiles['phone-tel'].set_sub(m.line1() if m.st and 'error' not in m.st else 'Calls and keypad')
            self.tiles['phone-sms'].set_sub('Messages')
            self.tiles['dlna'].set_sub('Not casting here' if c.mode() == 'wifi' else c.line1() if c.st else '')
            self.tiles['wifi'].set_sub(c.wline1() if c.st else '')
            self.tiles['data'].set_sub(m.line2() if m.st else '')
            self.tiles['fan'].set_sub(f.summary())
            self.update_dlna(); self.update_wifi(); self.update_data(); self.update_fan()
        except Exception:
            import traceback
            log(traceback.format_exc())


# ============================================================ icone de bandeja (StatusNotifierItem direto)
def make_pixmaps(sizes=(22, 32, 48)):
    """Icone branco (4 quadrados arredondados) em ARGB32; sem arquivos nem tema."""
    out = []
    for size in sizes:
        ss = 4; n = size * ss
        sq = round(n * 0.36); gap = round(n * 0.10); off = (n - 2 * sq - gap) // 2; r = n * 0.08
        rects = [(off, off), (off + sq + gap, off), (off, off + sq + gap), (off + sq + gap, off + sq + gap)]
        def inside(x, y):
            for cx, cy in rects:
                if cx <= x < cx + sq and cy <= y < cy + sq:
                    px = min(max(x, cx + r), cx + sq - r); py = min(max(y, cy + r), cy + sq - r)
                    if (x - px) ** 2 + (y - py) ** 2 <= r * r:
                        return True
            return False
        data = bytearray()
        for y in range(size):
            for x in range(size):
                cov = sum(1 for sy in range(ss) for sx in range(ss) if inside(x * ss + sx + 0.5, y * ss + sy + 0.5))
                a = round(255 * cov / (ss * ss))
                data += bytes((a, 255, 255, 255))
        out.append((size, size, bytes(data)))
    return out


def icon_pixbufs(sizes=(16, 22, 32, 48, 64)):
    """Os mesmos pixels do icone da bandeja, como GdkPixbuf (janela / dock)."""
    if GdkPixbuf is None:
        return []
    out = []
    for w, h, argb in make_pixmaps(sizes):
        rgba = bytearray()
        for i in range(0, len(argb), 4):
            rgba += bytes((255, 255, 255, argb[i]))
        out.append(GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(rgba)), GdkPixbuf.Colorspace.RGB, True, 8, w, h, w * 4))
    return out


def png_bytes(w, h, argb):
    import zlib, struct
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        for x in range(w):
            i = (y * w + x) * 4
            raw += bytes((255, 255, 255, argb[i]))
    def chunk(t, d):
        c = struct.pack('>I', len(d)) + t + d
        return c + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(bytes(raw), 9)) + chunk(b'IEND', b''))


def install_icons(root='/usr/share/icons/hicolor'):
    """Grava o icone 's9-panel' no tema (PNGs + SVG) para o .desktop / dock usarem o mesmo desenho da bandeja."""
    sizes = (16, 22, 24, 32, 48, 64, 96)
    for w, h, argb in make_pixmaps(sizes):
        d = '%s/%dx%d/apps' % (root, w, h)
        os.makedirs(d, exist_ok=True)
        with open(d + '/s9-panel.png', 'wb') as f:
            f.write(png_bytes(w, h, argb))
        print('   gravado', d + '/s9-panel.png')
    d = root + '/scalable/apps'
    os.makedirs(d, exist_ok=True)
    rects = ''.join('<rect x="%d" y="%d" width="36" height="36" rx="8" fill="#ffffff"/>' % p
                    for p in ((9, 9), (55, 9), (9, 55), (55, 55)))
    with open(d + '/s9-panel.svg', 'w') as f:
        f.write('<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100">%s</svg>\n' % rects)
    print('   gravado', d + '/s9-panel.svg')
    if shutil.which('gtk-update-icon-cache'):
        subprocess.call(['gtk-update-icon-cache', '-f', '-t', root], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print('   cache de icones atualizado')
    return 0


SNI_XML = '''<node><interface name="org.kde.StatusNotifierItem">
<property name="Category" type="s" access="read"/><property name="Id" type="s" access="read"/>
<property name="Title" type="s" access="read"/><property name="Status" type="s" access="read"/>
<property name="IconName" type="s" access="read"/><property name="IconThemePath" type="s" access="read"/>
<property name="IconPixmap" type="a(iiay)" access="read"/>
<property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
<property name="ItemIsMenu" type="b" access="read"/><property name="Menu" type="o" access="read"/>
<method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
</interface></node>'''


class Tray:
    def __init__(self, on_click):
        self.on_click, self.last, self.watch_id = on_click, 0.0, None
        icon = read_conf().get('icon', '')
        self.icon_name = icon
        self.pix = [] if icon else make_pixmaps()
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        self.conn.register_object('/StatusNotifierItem', node.interfaces[0], self._call, self._get, None)
        self.name = 'org.kde.StatusNotifierItem-%d-1' % os.getpid()
        r = self.conn.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'RequestName',
                                GLib.Variant('(su)', (self.name, 0)), None, Gio.DBusCallFlags.NONE, -1, None)
        log('tray: RequestName', r.unpack())
        self.watch_id = Gio.bus_watch_name(Gio.BusType.SESSION, WATCHER, Gio.BusNameWatcherFlags.NONE,
                                           self._appeared, self._vanished)

    def _appeared(self, conn, name, owner):
        GLib.timeout_add_seconds(1, self._register)

    def _vanished(self, conn, name):
        log('tray: watcher saiu; aguardando')

    def _register(self):
        try:
            self.conn.call_sync(WATCHER, '/StatusNotifierWatcher', WATCHER, 'RegisterStatusNotifierItem',
                                GLib.Variant('(s)', (self.name,)), None, Gio.DBusCallFlags.NONE, 5000, None)
            log('tray: registrado como', self.name)
        except Exception as e:
            log('tray: registro falhou:', e)
        return False

    def _call(self, conn, sender, path, iface, method, params, inv):
        inv.return_value(None)
        now = time.monotonic()
        if method in ('Activate', 'SecondaryActivate', 'ContextMenu') and now - self.last > 0.6:
            self.last = now
            ui(self.on_click)

    def _get(self, conn, sender, path, iface, prop):
        v = {
            'Category': ('s', 'ApplicationStatus'), 'Id': ('s', 's9_panel'), 'Title': ('s', 'S9 Panel'),
            'Status': ('s', 'Active'), 'IconName': ('s', self.icon_name), 'IconThemePath': ('s', ''),
            'IconPixmap': ('a(iiay)', self.pix),
            'ToolTip': ('(sa(iiay)ss)', ('', [], 'S9 Panel', 'Phone, SMS, screen cast, mobile data and fan')),
            'ItemIsMenu': ('b', False), 'Menu': ('o', '/NO_DBUSMENU'),
        }.get(prop)
        return GLib.Variant(v[0], v[1]) if v else None


# ============================================================ aplicacao
class PanelApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win, self.tray = None, None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()

    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        first = self.win is None
        if first:
            self.win = PanelWindow(self)
            if '--no-tray' not in args:
                try:
                    self.tray = Tray(lambda: self.win.toggle())
                except Exception as e:
                    log('tray: falhou:', e)
        page = args[args.index('--page') + 1] if '--page' in args and args.index('--page') + 1 < len(args) else None
        if '--background' in args and first and '--show' not in args:
            return 0
        if '--toggle' in args:
            self.win.toggle(page)
        else:
            self.win.show_panel(page)
        return 0


def selftest():
    """Sem tray: abre a janela na pagina do Phone, espera, e imprime o estado dos modelos e do encaixe."""
    win = PanelWindow(None)
    win.show_panel('phone-sms')
    def report():
        c, m, f = win.cast, win.mob, win.fan
        print('modem   :', m.line1(), '|', m.line2())
        print('cast    :', c.line1(), '| alvos DLNA/Cast=%d, Wi-Fi=%d' % (len(c.targets), len(c.wtargets)))
        print('fan     :', f.summary())
        pw = win.phone.sock.get_plug_window()
        print('phone   : xid=%s embutido=%s plug_viewable=%s' % (
            win.phone.xid, win.phone.embedded, (pw.is_viewable() if pw is not None else None)))
        win.phone.stop()
        GLib.timeout_add(500, Gtk.main_quit)
        return False
    GLib.timeout_add_seconds(7, report)
    Gtk.main()
    return 0


def main():
    if '--install-icons' in sys.argv:
        i = sys.argv.index('--install-icons')
        return install_icons(sys.argv[i + 1] if i + 1 < len(sys.argv) else '/usr/share/icons/hicolor')
    if '--selftest' in sys.argv:
        return selftest()
    return PanelApp().run(sys.argv)


if __name__ == '__main__':
    sys.exit(main())
