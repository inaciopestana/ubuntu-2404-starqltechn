#!/usr/bin/env python3

import ctypes
import ctypes.util
import os
import subprocess
import time

DISPLAY = os.environ.get("DISPLAY", ":0")

#
# Esperar o Xwayland terminar de estabelecer a root.
#
for _ in range(80):
    try:
        out = subprocess.check_output(
            ["xdpyinfo"],
            env={**os.environ, "DISPLAY": DISPLAY},
            stderr=subprocess.DEVNULL,
            text=True,
        )

        dims = None

        for line in out.splitlines():
            if "dimensions:" in line:
                dims = line.split("dimensions:", 1)[1].strip().split()[0]
                break

        if dims:
            w, h = map(int, dims.split("x"))

            if w > 300 and h > 300:
                break

    except Exception:
        pass

    time.sleep(0.1)

#
# Esse foi o passo que anteriormente mudou o xfdesktop
# de 200x200 para o tamanho real da root.
#
subprocess.run(
    ["xfdesktop", "--reload"],
    env={**os.environ, "DISPLAY": DISPLAY},
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)

time.sleep(0.6)

libname = ctypes.util.find_library("X11") or "libX11.so.6"
X = ctypes.CDLL(libname)

Display_p = ctypes.c_void_p
Window = ctypes.c_ulong

class XWindowAttributes(ctypes.Structure):
    _fields_ = [
        ("x", ctypes.c_int),
        ("y", ctypes.c_int),
        ("width", ctypes.c_int),
        ("height", ctypes.c_int),
        ("border_width", ctypes.c_int),
        ("depth", ctypes.c_int),
        ("visual", ctypes.c_void_p),
        ("root", Window),
        ("class_", ctypes.c_int),
        ("bit_gravity", ctypes.c_int),
        ("win_gravity", ctypes.c_int),
        ("backing_store", ctypes.c_int),
        ("backing_planes", ctypes.c_ulong),
        ("backing_pixel", ctypes.c_ulong),
        ("save_under", ctypes.c_int),
        ("colormap", ctypes.c_ulong),
        ("map_installed", ctypes.c_int),
        ("map_state", ctypes.c_int),
        ("all_event_masks", ctypes.c_long),
        ("your_event_mask", ctypes.c_long),
        ("do_not_propagate_mask", ctypes.c_long),
        ("override_redirect", ctypes.c_int),
        ("screen", ctypes.c_void_p),
    ]

X.XOpenDisplay.argtypes = [ctypes.c_char_p]
X.XOpenDisplay.restype = Display_p

X.XDefaultRootWindow.argtypes = [Display_p]
X.XDefaultRootWindow.restype = Window

X.XQueryTree.argtypes = [
    Display_p,
    Window,
    ctypes.POINTER(Window),
    ctypes.POINTER(Window),
    ctypes.POINTER(ctypes.POINTER(Window)),
    ctypes.POINTER(ctypes.c_uint),
]
X.XQueryTree.restype = ctypes.c_int

X.XFetchName.argtypes = [
    Display_p,
    Window,
    ctypes.POINTER(ctypes.c_char_p),
]
X.XFetchName.restype = ctypes.c_int

X.XGetWindowAttributes.argtypes = [
    Display_p,
    Window,
    ctypes.POINTER(XWindowAttributes),
]
X.XGetWindowAttributes.restype = ctypes.c_int

X.XMoveResizeWindow.argtypes = [
    Display_p,
    Window,
    ctypes.c_int,
    ctypes.c_int,
    ctypes.c_uint,
    ctypes.c_uint,
]

X.XFlush.argtypes = [Display_p]

X.XFree.argtypes = [ctypes.c_void_p]

dpy = X.XOpenDisplay(DISPLAY.encode())

if not dpy:
    raise SystemExit("XOpenDisplay falhou")

root = X.XDefaultRootWindow(dpy)

root_attr = XWindowAttributes()

if not X.XGetWindowAttributes(
    dpy,
    root,
    ctypes.byref(root_attr),
):
    raise SystemExit("XGetWindowAttributes(root) falhou")

root_w = root_attr.width
root_h = root_attr.height

print(
    f"ROOT_GEOMETRY={root_w}x{root_h}+0+0",
    flush=True,
)

best = None
best_area = -1

def scan(win, depth=0):
    global best, best_area

    if depth > 5:
        return

    root_ret = Window()
    parent_ret = Window()
    children = ctypes.POINTER(Window)()
    nchildren = ctypes.c_uint()

    if not X.XQueryTree(
        dpy,
        win,
        ctypes.byref(root_ret),
        ctypes.byref(parent_ret),
        ctypes.byref(children),
        ctypes.byref(nchildren),
    ):
        return

    try:
        for i in range(nchildren.value):
            child = children[i]

            name_ptr = ctypes.c_char_p()

            name = ""

            if X.XFetchName(
                dpy,
                child,
                ctypes.byref(name_ptr),
            ) and name_ptr.value:

                try:
                    name = name_ptr.value.decode(
                        "utf-8",
                        "replace"
                    )
                finally:
                    X.XFree(name_ptr)

            attr = XWindowAttributes()

            if X.XGetWindowAttributes(
                dpy,
                child,
                ctypes.byref(attr),
            ):
                if name == "Desktop":
                    area = attr.width * attr.height

                    print(
                        "DESKTOP_FOUND "
                        f"id=0x{child:x} "
                        f"geometry="
                        f"{attr.width}x{attr.height}"
                        f"{attr.x:+d}{attr.y:+d}",
                        flush=True,
                    )

                    if area > best_area:
                        best_area = area
                        best = child

            scan(child, depth + 1)

    finally:
        if children:
            X.XFree(children)

for attempt in range(8):

    best = None
    best_area = -1

    scan(root)

    if best is not None:

        attr = XWindowAttributes()

        X.XGetWindowAttributes(
            dpy,
            best,
            ctypes.byref(attr),
        )

        if (
            attr.x != 0 or
            attr.y != 0 or
            attr.width != root_w or
            attr.height != root_h
        ):
            print(
                "DESKTOP_FIX "
                f"from="
                f"{attr.width}x{attr.height}"
                f"{attr.x:+d}{attr.y:+d} "
                f"to={root_w}x{root_h}+0+0",
                flush=True,
            )

            X.XMoveResizeWindow(
                dpy,
                best,
                0,
                0,
                root_w,
                root_h,
            )

            X.XFlush(dpy)

        else:
            print(
                "DESKTOP_ALREADY_CORRECT=1",
                flush=True,
            )

    time.sleep(0.25)
