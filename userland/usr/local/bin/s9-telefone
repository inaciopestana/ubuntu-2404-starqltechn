#!/usr/bin/env python3
"""s9-telefone: app de telefone para o S9 (GTK3). Fala com o s9-phoned por /run/s9-phone.sock."""
import json, os, re, socket, subprocess, sys, time

SOCK = '/run/s9-phone.sock'
CFG_DIR = os.path.expanduser('~/.config/s9-telefone')
SND_DIR = '/usr/local/share/s9-telefone'

# ============================================================ utilidades (sem GTK)
def digits(n):
    return re.sub(r'\D', '', n or '')

def num_key(n):
    d = digits(n)
    return d[-9:] if len(d) >= 8 else (n or '').strip()

def fmt_number(n):
    n = (n or '').strip()
    if not n:
        return 'Hidden number'
    d = digits(n)
    special = n.startswith(('+', '*', '#'))
    if n.startswith('+55') and len(d) == 13:
        return '+55 (%s) %s-%s' % (d[2:4], d[4:9], d[9:])
    if n.startswith('+55') and len(d) == 12:
        return '+55 (%s) %s-%s' % (d[2:4], d[4:8], d[8:])
    if not special and len(d) == 11:
        return '(%s) %s-%s' % (d[:2], d[2:7], d[7:])
    if not special and len(d) == 10:
        return '(%s) %s-%s' % (d[:2], d[2:6], d[6:])
    return n

def fmt_time(ts):
    t = time.localtime(ts)
    if time.strftime('%Y%m%d', t) == time.strftime('%Y%m%d'):
        return time.strftime('%H:%M', t)
    return time.strftime('%d/%m %H:%M', t)

def fmt_dur(s):
    s = int(s)
    if s < 60:
        return '%d s' % s
    return '%d min %02d s' % (s // 60, s % 60)

def fmt_clock(s):
    s = max(0, int(s))
    return '%02d:%02d' % (s // 60, s % 60) if s < 3600 else '%d:%02d:%02d' % (s // 3600, s % 3600 // 60, s % 60)

def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default

def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)

class Contacts:
    def __init__(self, path=None):
        self.path = path or os.path.join(CFG_DIR, 'contatos.json')
        data = load_json(self.path, [])
        self.items = [c for c in data if isinstance(c, dict) and c.get('name') and c.get('number')]

    def save(self):
        save_json(self.path, self.items)

    def name_for(self, number):
        k = num_key(number)
        if not k:
            return None
        for c in self.items:
            if num_key(c['number']) == k:
                return c['name']
        return None

    def upsert(self, old_number, name, number):
        if old_number:
            self.delete(old_number, save=False)
        self.items = [c for c in self.items if num_key(c['number']) != num_key(number)]
        self.items.append({'name': name.strip(), 'number': number.strip()})
        self.save()

    def delete(self, number, save=True):
        self.items = [c for c in self.items if num_key(c['number']) != num_key(number)]
        if save:
            self.save()

    def sorted(self):
        return sorted(self.items, key=lambda c: c['name'].lower())

class ReadState:
    def __init__(self, path=None):
        self.path = path or os.path.join(CFG_DIR, 'estado.json')
        self.read = load_json(self.path, {}).get('read', {})

    def mark(self, key, ts):
        self.read[key] = ts
        save_json(self.path, {'read': self.read})

class Backend:
    """Cliente do s9-phoned: um JSON por linha; reconecta sozinho."""
    def __init__(self, on_event, on_conn, sock_path=SOCK):
        self.on_event, self.on_conn, self.path = on_event, on_conn, sock_path
        self.sock = None; self.buf = b''; self.nid = 1; self.pending = {}

    def start(self):
        self.connect()
        GLib.timeout_add_seconds(3, self._retry)

    def _retry(self):
        if not self.sock:
            self.connect()
        return True

    def connect(self):
        if self.sock:
            return
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(1)
            s.connect(self.path)
            s.settimeout(None)
        except OSError:
            return
        self.sock = s; self.buf = b''
        GLib.io_add_watch(s.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._readable)
        self.on_conn(True)

    def _drop(self):
        s, self.sock = self.sock, None
        if s:
            try: s.close()
            except OSError: pass
        pend, self.pending = self.pending, {}
        for cb in pend.values():
            if cb: cb({'ok': False, 'error': 'phone service stopped'})
        self.on_conn(False)

    def _readable(self, fd, cond):
        s = self.sock
        if not s or s.fileno() != fd:
            return False
        try:
            data = s.recv(65536)
        except OSError:
            data = b''
        if not data:
            self._drop()
            return False
        self.buf += data
        while b'\n' in self.buf:
            line, self.buf = self.buf.split(b'\n', 1)
            try:
                m = json.loads(line.decode())
            except ValueError:
                continue
            rid = m.get('id')
            if rid is not None and rid in self.pending:
                cb = self.pending.pop(rid)
                if cb: cb(m)
            elif 'event' in m:
                self.on_event(m)
        return True

    def send(self, req, cb=None):
        if not self.sock:
            if cb: cb({'ok': False, 'error': 'phone service not running'})
            return
        req = dict(req); req['id'] = self.nid; self.pending[self.nid] = cb; self.nid += 1
        try:
            self.sock.sendall((json.dumps(req) + '\n').encode())
        except OSError:
            self._drop()

# ---- audio da chamada (earpiece x alto-falante) pelo Pulse
def run_pactl(*args):
    r = subprocess.run(['pactl', *args], capture_output=True, text=True, timeout=6)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:200] or 'pactl failed')
    return r.stdout

def primary_sink():
    sinks = json.loads(run_pactl('--format=json', 'list', 'sinks'))
    for s in sinks:
        if 'PRIMARY' in str(s.get('properties', {}).get('droid.flags', '')):
            return s
    for s in sinks:
        if str(s.get('name', '')).startswith('sink.'):
            return s
    raise RuntimeError('phone sink not found')

def _active_port(s):
    a = s.get('active_port') or ''
    return a.get('name', '') if isinstance(a, dict) else str(a)

def route_call(speaker):
    s = primary_sink()
    names = [p['name'] for p in s.get('ports', [])]
    want, frag = ('output-speaker', 'speaker') if speaker else ('output-earpiece', 'earpiece')
    target = want if want in names else next((n for n in names if frag in n), None)
    if not target:
        raise RuntimeError('port "%s" not found (ports: %s)' % (frag, ', '.join(names)))
    run_pactl('set-sink-port', s['name'], target)
    return target

def restore_port():
    s = primary_sink()
    act = _active_port(s)
    if act and 'parking' not in act and 'earpiece' not in act:
        return None
    cands = [p for p in s.get('ports', [])
             if not any(x in p['name'] for x in ('parking', 'earpiece')) and p.get('availability') != 'not available']
    if not cands:
        return None
    best = max(cands, key=lambda p: p.get('priority', 0))
    run_pactl('set-sink-port', s['name'], best['name'])
    return best['name']

class Ringer:
    def __init__(self, ring, ding):
        self.ring, self.ding, self.proc, self.tid = ring, ding, None, None

    def _play(self, f):
        if os.path.exists(f):
            try:
                return subprocess.Popen(['paplay', f], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
        return None

    def _tick(self):
        if self.proc is None or self.proc.poll() is not None:
            self.proc = self._play(self.ring)
        return True

    def set(self, on):
        if on and not self.tid:
            self._tick(); self.tid = GLib.timeout_add(2500, self._tick)
        elif not on and self.tid:
            GLib.source_remove(self.tid); self.tid = None
            if self.proc and self.proc.poll() is None:
                self.proc.terminate()
            self.proc = None

    def once(self):
        self._play(self.ding)

class NoRinger:
    # S9_PANEL_EMBED: a copia encaixada no painel nunca toca nem apita (quem toca e o app principal)
    def set(self, on):
        pass

    def once(self):
        pass

