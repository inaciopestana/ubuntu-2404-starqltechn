#!/usr/bin/env python3
"""Bandeja da ventoinha da DeX Station: Auto / High / Medium / Low / Off.

Aparece no painel somente quando a dock (04e8:a020) esta conectada.
Controla o servico via `sudo -n /usr/local/sbin/s9-dex-fan <modo>`.
Uso: s9-dex-fan-tray [--selftest | --make-icons]
"""
import os, sys, glob, fcntl, subprocess, threading, importlib, time

CLI = '/usr/local/sbin/s9-dex-fan'
IDS = os.environ.get('S9FAN_IDS', '/sys/class/sec/ccic/usbpd_ids')
PARTNER = os.environ.get('S9FAN_PARTNER', '/sys/class/typec/port0-partner')
THERM = os.environ.get('S9FAN_THERM', '/sys/class/thermal')
SDIR = os.environ.get('S9FAN_STATE', '/var/lib/s9-dex-fan')
ICONS = os.environ.get('S9FAN_ICONS', '/usr/local/share/s9-dex-fan/icons')
LEVELS = ['off', 'low', 'medium', 'high']
COLORS = {'off': '#8a8f98', 'low': '#3fb950', 'medium': '#f0a000', 'high': '#e5484d'}
MODES = [('auto', 'Auto'), ('high', 'High'), ('medium', 'Medium'), ('low', 'Low'), ('off', 'Off')]
POLL_S = 3          # leitura interna (icone, modo, dock)
DISPLAY_S = 10      # a temperatura exibida no menu atualiza mais devagar (media do intervalo)


# ---------- icones ----------
FG = '#ffffff'
BARS = {'off': 0, 'low': 1, 'medium': 2, 'high': 3}


def svg(level, auto):   # S9_FAN_ICON_TEXT_V1: ventoinha em cima, palavra embaixo (curvas, sem fonte)
    _P = {"OFF": "M7.18 18.65Q6.57 18.65 6.24 19.15Q5.9 19.64 5.9 20.55Q5.9 21.45 6.24 21.94Q6.57 22.44 7.18 22.44Q7.79 22.44 8.12 21.94Q8.46 21.45 8.46 20.55Q8.46 19.64 8.12 19.15Q7.79 18.65 7.18 18.65ZM7.18 17.58Q8.42 17.58 9.12 18.37Q9.82 19.16 9.82 20.55Q9.82 21.93 9.12 22.72Q8.42 23.51 7.18 23.51Q5.94 23.51 5.24 22.72Q4.53 21.93 4.53 20.55Q4.53 19.16 5.24 18.37Q5.94 17.58 7.18 17.58ZM10.82 17.68H14.4V18.8H12.15V19.86H14.27V20.98H12.15V23.4H10.82ZM15.65 17.68H19.23V18.8H16.97V19.86H19.09V20.98H16.97V23.4H15.65Z", "LOW": "M3.51 17.68H4.84V22.29H7.17V23.4H3.51ZM10.36 18.65Q9.75 18.65 9.42 19.15Q9.08 19.64 9.08 20.55Q9.08 21.45 9.42 21.94Q9.75 22.44 10.36 22.44Q10.96 22.44 11.3 21.94Q11.63 21.45 11.63 20.55Q11.63 19.64 11.3 19.15Q10.96 18.65 10.36 18.65ZM10.36 17.58Q11.6 17.58 12.3 18.37Q13 19.16 13 20.55Q13 21.93 12.3 22.72Q11.6 23.51 10.36 23.51Q9.12 23.51 8.41 22.72Q7.71 21.93 7.71 20.55Q7.71 19.16 8.41 18.37Q9.12 17.58 10.36 17.58ZM13.56 17.68H14.84L15.72 21.84L16.61 17.68H17.89L18.77 21.84L19.66 17.68H20.92L19.71 23.4H18.17L17.24 19.05L16.32 23.4H14.79Z", "MED": "M3.8 17.68H5.48L6.66 20.74L7.84 17.68H9.52V23.4H8.26V19.22L7.08 22.3H6.24L5.06 19.22V23.4H3.8ZM10.82 17.68H14.4V18.8H12.15V19.86H14.27V20.98H12.15V22.29H14.48V23.4H10.82ZM16.97 18.8V22.29H17.44Q18.26 22.29 18.68 21.84Q19.11 21.39 19.11 20.54Q19.11 19.69 18.69 19.24Q18.26 18.8 17.44 18.8ZM15.64 17.68H17.04Q18.21 17.68 18.79 17.87Q19.36 18.05 19.77 18.5Q20.13 18.89 20.31 19.39Q20.48 19.9 20.48 20.54Q20.48 21.18 20.31 21.69Q20.13 22.2 19.77 22.58Q19.35 23.03 18.78 23.21Q18.2 23.4 17.04 23.4H15.64Z", "HIGH": "M2.54 17.68H3.86V19.86H5.82V17.68H7.15V23.4H5.82V20.98H3.86V23.4H2.54ZM8.44 17.68H9.77V23.4H8.44ZM15.69 22.97Q15.19 23.24 14.66 23.38Q14.12 23.51 13.56 23.51Q12.27 23.51 11.52 22.71Q10.77 21.91 10.77 20.55Q10.77 19.16 11.53 18.37Q12.3 17.58 13.63 17.58Q14.14 17.58 14.61 17.69Q15.08 17.79 15.5 18V19.19Q15.07 18.92 14.64 18.78Q14.22 18.65 13.79 18.65Q13 18.65 12.57 19.14Q12.14 19.63 12.14 20.55Q12.14 2