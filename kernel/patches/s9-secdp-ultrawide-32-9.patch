diff --git a/drivers/gpu/drm/msm/dp/dp_drm.c b/drivers/gpu/drm/msm/dp/dp_drm.c
index 799f63e61d1d..dc0359370b81 100644
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -453,6 +453,32 @@ int dp_connector_get_modes(struct drm_connector *connector,
 			m->width_mm = connector->display_info.width_mm;
 			m->height_mm = connector->display_info.height_mm;
 			drm_mode_probed_add(connector, m);
+#if defined(CONFIG_SEC_DISPLAYPORT) && defined(SECDP_WIDE_32_9_SUPPORT) /* S9-ULTRAWIDE-60 */
+			{
+				/* monitores 32:9 anunciam 3840x1080 so em alta taxa no EDID:
+				 * sintetiza 3840x1080@60 (CVT, blanking reduzido) para o modo de menor banda */
+				struct drm_display_mode *pm, *m60;
+				bool has_1080 = false, has_60 = false;
+			
+				list_for_each_entry(pm, &connector->probed_modes, head) {
+					if (pm->hdisplay == 3840 && pm->vdisplay == 1080) {
+						has_1080 = true;
+						if (drm_mode_vrefresh(pm) == 60)
+							has_60 = true;
+					}
+				}
+				if (has_1080 && !has_60) {
+					m60 = drm_cvt_mode(connector->dev, 3840, 1080, 60, true, false, false);
+					if (m60) {
+						m60->type = DRM_MODE_TYPE_DRIVER;
+						m60->width_mm = connector->display_info.width_mm;
+						m60->height_mm = connector->display_info.height_mm;
+						drm_mode_probed_add(connector, m60);
+						rc++;
+					}
+				}
+			}
+#endif
 		}
 	} else {
 		pr_err("No sink connected\n");
