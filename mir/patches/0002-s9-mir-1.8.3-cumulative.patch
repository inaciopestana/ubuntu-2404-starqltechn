+// S9_XWOBS_WAIT_V1
+/*
+ * close() exige que o XWaylandSurfaceObserver tenha morrido (ele guarda um ponteiro cru para o XWaylandSurface).
+ * Outra thread pode estar, nesse instante, no meio de uma notificacao da superficie (o multiplexador de
+ * observers segura uma copia shared_ptr durante a iteracao) ou com trabalho enfileirado. Em vez de abortar o
+ * Mir inteiro, espera ate 3 s (sem segurar trava alguma) que a ultima referencia caia.
+ */
+static void s9_wait_observer_dead(std::weak_ptr<mir::frontend::XWaylandSurfaceObserver> const& weak)
+{
+    auto const start = std::chrono::steady_clock::now();
+    bool logged = false;
+    long first_count = 0;
+    for (;;)
+    {
+        {
+            auto const alive = weak.lock();
+            if (!alive)
+            {
+                if (logged)
+                    fprintf(stderr, "S9_XWOBS_WAIT_V1: observer liberado apos %lld ms (use count inicial %ld)\n",
+                        (long long)std::chrono::duration_cast<std::chrono::milliseconds>(
+                            std::chrono::steady_clock::now() - start).count(), first_count);
+                return;
+            }
+            if (!logged)
+            {
+                logged = true;
+                first_count = alive.use_count();
+                fprintf(stderr, "S9_XWOBS_WAIT_V1: observer ainda referenciado no close() (use count %ld); aguardando\n",
+                    first_count);
+            }
+        }
+        if (std::chrono::steady_clock::now() - start > std::chrono::milliseconds(3000))
+        {
+            fprintf(stderr, "S9_XWOBS_WAIT_V1: tempo esgotado (3 s); mantendo o fatal_error original\n");
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+}
