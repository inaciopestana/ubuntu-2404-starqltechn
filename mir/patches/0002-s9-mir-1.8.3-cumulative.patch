+void s9_make_local_configuration_edid_adaptive(
+    mgn::NestedDisplayConfiguration& configuration)
+{
+    auto const displayport_type =
+        static_cast<mg::DisplayConfigurationOutputType>(
+            mir_output_type_displayport);
+
+    bool displayport_connected = false;
+
+    static_cast<mg::DisplayConfiguration const&>(
+        configuration)
+        .for_each_output(
+            [&](mg::DisplayConfigurationOutput const& output)
+            {
+                if (output.connected &&
+                    output.type == displayport_type &&
+                    !output.modes.empty())
+                {
+                    displayport_connected = true;
+                }
+            });
+
+    /*
+     * No external monitor:
+     *
+     * Keep normal phone-only configuration unchanged.
+     */
+    if (!displayport_connected)
+        return;
+
+    /*
+     * Task12M
+     *
+     * The external DisplayPort becomes the logical origin
+     * and therefore the natural primary desktop:
+     *
+     *     DP    : +0+0
+     *     LVDS  : +(DP logical width)+0
+     *
+     * DP width is obtained dynamically from the EDID-selected
+     * mode. Nothing here assumes 1920, 2560, or any particular
+     * monitor.
+     */
+    int external_width = 0;
+
+
+    /*
+     * PASS 1:
+     *
+     * Configure DisplayPort first and determine its logical
+     * width. It is unrotated and scale=1, therefore logical
+     * width == selected mode width.
+     */
+    configuration.for_each_output(
+        [&](mg::UserDisplayConfigurationOutput& output)
+        {
+            if (!(output.connected &&
+                  output.type == displayport_type &&
+                  !output.modes.empty()))
+            {
+                return;
+            }
+
+            output.used = true;
+
+            output.power_mode =
+                mir_power_mode_on;
+
+            output.orientation =
+                mir_orientation_normal;
+
+            output.scale = 1.0f;
+
+            output.top_left =
+                mir::geometry::Point{0, 0};
+
+
+            auto const selected =
+                s9_select_external_mode(output);
+
+            output.current_mode_index =
+                static_cast<uint32_t>(
+                    selected);
+
+
+            auto const preferred =
+                output.preferred_mode_index <
+                    output.modes.size() ?
+                output.preferred_mode_index :
+                0;
+
+
+            auto const& preferred_mode =
+                output.modes[preferred];
+
+            auto const& selected_mode =
+                output.modes[selected];
+
+
+            external_width =
+                selected_mode.size.width.as_int();
+
+
+            mir::log_info(
+                "TASK12I DP SELECT: "
+                "preferred[%zu]=%dx%d@%.3f "
+                "selected[%zu]=%dx%d@%.3f "
+                "modes=%zu",
+                static_cast<std::size_t>(
+                    preferred),
+                preferred_mode.size.width.as_int(),
+                preferred_mode.size.height.as_int(),
+                preferred_mode.vrefresh_hz,
+                selected,
+                selected_mode.size.width.as_int(),
+                selected_mode.size.height.as_int(),
+                selected_mode.vrefresh_hz,
+                output.modes.size());
+
+
+            for (std::size_t i = 0;
+                 i < output.modes.size();
+                 ++i)
+            {
+                auto const& mode =
+                    output.modes[i];
+
+                mir::log_info(
+                    "TASK12I DP MODE[%zu]: "
+                    "%dx%d@%.3f%s%s",
+                    i,
+                    mode.size.width.as_int(),
+                    mode.size.height.as_int(),
+                    mode.vrefresh_hz,
+                    i == preferred ?
+                        " preferred" : "",
+                    i == selected ?
+                        " selected" : "");
+            }
+
+
+            mir::log_info(
+                "TASK12M PRIMARY DP: "
+                "mode=%dx%d@%.3f "
+                "pos=+0+0 "
+                "scale=1",
+                selected_mode.size.width.as_int(),
+                selected_mode.size.height.as_int(),
+                selected_mode.vrefresh_hz);
+        });
+
+
+    if (external_width <= 0)
+    {
+        mir::log_warning(
+            "TASK12M: external_width invalid: %d",
+            external_width);
+
+        return;
+    }
+
+
+    /*
+     * PASS 2 — TASK12O:
+     *
+     * The phone panel must NOT participate in the nested/local
+     * desktop while DisplayPort is connected.
+     *
+     * Keep its canonical physical geometry/mode information here,
+     * but mark it unused locally.  s9_host_compatible_configuration()
+     * will re-enable it only in the clone sent to Samsung LSC/HWC.
+     *
+     * This deliberately separates:
+     *
+     *   local/Xwayland : DP only
+     *   host/HWC       : DP + physical LVDS kept alive
+     *
+     * The LVDS position remains deterministic at external_width,0
+     * so the host configuration is identical on every hotplug.
+     */
+    configuration.for_each_output(
+        [&](mg::UserDisplayConfigurationOutput& output)
+        {
+            if (!(output.connected &&
+                  s9_has_mode(
+                      output,
+                      1440,
+                      2960)))
+            {
+                return;
+            }
+
+
+            /*
+             * TASK12O:
+             *
+             * Hide LVDS from the nested/local desktop.
+             * Do NOT power it off here: the host clone below will
+             * explicitly keep the Samsung physical primary alive.
+             */
+            output.used = false;
+
+            output.power_mode =
+                mir_power_mode_on;
+
+            /* TASK12N: preserve current/runtime LVDS orientation. */
+            output.scale = 1.0f;
+
+            /*
+             * Canonical host slot.  Absolute, never relative to
+             * the previous hotplug configuration.
+             */
+            output.top_left =
+                mir::geometry::Point{
+                    external_width,
+                    0};
+
+
+            /*
+             * Force native physical panel mode.
+             */
+            for (std::size_t i = 0;
+                 i < output.modes.size();
+                 ++i)
+            {
+                auto const& mode =
+                    output.modes[i];
+
+                if (
+                    mode.size.width.as_int() ==
+                        1440 &&
+                    mode.size.height.as_int() ==
+                        2960)
+                {
+                    output.current_mode_index =
+                        static_cast<uint32_t>(i);
+
+                    break;
+                }
+            }
+
+
+            mir::log_info(
+                "TASK12O LOCAL-HIDDEN LVDS: "
+                "native=1440x2960 "
+                "orientation=right "
+                "logical=2960x1440 "
+                "pos=+%d+0 "
+                "scale=1",
+                external_width);
+        });
+}
+
+/*
+ * Samsung's HWC path crashes when the primary LVDS output is disabled
+ * while the external DisplayPort output is active.
+ *
+ * Keep the nested/local configuration unchanged (so Xwayland sees only
+ * the external output), but send a host-specific clone to LSC with the
+ * physical primary panel kept enabled and powered.
+ */
+std::unique_ptr<mgn::NestedDisplayConfiguration>
+s9_host_compatible_configuration(
+    mg::DisplayConfiguration const& local_configuration)
+{
+    auto host_configuration =
+        std::unique_ptr<mgn::NestedDisplayConfiguration>{
+            dynamic_cast<mgn::NestedDisplayConfiguration*>(
+                local_configuration.clone().release())};
+
+    if (!host_configuration)
+    {
+        BOOST_THROW_EXCEPTION(
+            std::logic_error(
+                "Failed to clone nested display configuration"));
+    }
+
+    bool external_active = false;
+
+    local_configuration.for_each_output(
+        [&](mg::DisplayConfigurationOutput const& output)
+        {
+            if (output.connected &&
+                output.used &&
+                (
+                    output.type ==
+                        static_cast<decltype(output.type)>(
+                            mir_output_type_displayport) &&
+                    !output.modes.empty()))
+            {
+                external_active = true;
+            }
+        });
+
+    if (external_active)
+    {
+        host_configuration->for_each_output(
+            [&](mg::UserDisplayConfigurationOutput& output)
+            {
+                if (output.connected &&
+                    s9_has_mode(output, 1440, 2960))
+                {
+                    output.used = true;
+                    output.power_mode = mir_power_mode_on;
+                }
+            });
+    }
+
+    return host_configuration;
+}
