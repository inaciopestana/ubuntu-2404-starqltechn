+// Escrita assincrona (nao bloqueia o compositor) de um texto em um pipe de cliente.
+struct WriteJob
+{
+    static void start(wl_event_loop* loop, int fd, std::string data)
+    {
+        int const fl = ::fcntl(fd, F_GETFL);
+        if (fl >= 0) ::fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+
+        std::unique_ptr<WriteJob> job{new WriteJob{loop, fd, std::move(data)}};
+        if (job->pump())
+            return;  // terminou (ou falhou) de imediato; o destrutor fecha o fd
+
+        job->src = wl_event_loop_add_fd(loop, fd, WL_EVENT_WRITABLE, &WriteJob::on_writable, job.get());
+        job->timer = wl_event_loop_add_timer(loop, &WriteJob::on_timeout, job.get());
+        if (job->src && job->timer)
+        {
+            wl_event_source_timer_update(job->timer, 5000);
+            job.release();  // passa a ser dono de si mesmo
+        }
+    }
+
+    ~WriteJob()
+    {
+        if (src) wl_event_source_remove(src);
+        if (timer) wl_event_source_remove(timer);
+        if (fd >= 0) ::close(fd);
+    }
+
+private:
+    WriteJob(wl_event_loop* l, int f, std::string d) : loop{l}, fd{f}, data{std::move(d)} {}
+
+    // true = acabou (sucesso ou erro)
+    bool pump()
+    {
+        while (pos < data.size())
+        {
+            ssize_t n = ::write(fd, data.data() + pos, data.size() - pos);
+            if (n > 0)
+            {
+                pos += static_cast<size_t>(n);
+                continue;
+            }
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return false;
+            return true;  // EPIPE etc.: o leitor sumiu
+        }
+        return true;
+    }
+
+    static int on_writable(int, uint32_t, void* d)
+    {
+        auto* self = static_cast<WriteJob*>(d);
+        if (self->pump()) delete self;
+        return 0;
+    }
+
+    static int on_timeout(void* d)
+    {
+        delete static_cast<WriteJob*>(d);
+        return 0;
+    }
+
+    wl_event_loop* const loop;
+    int fd;
+    std::string const data;
+    size_t pos = 0;
+    wl_event_source* src = nullptr;
+    wl_event_source* timer = nullptr;
