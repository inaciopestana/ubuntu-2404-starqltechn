+template<typename Output>
+bool s9_has_mode(Output const& output, int width, int height)
+{
+    for (auto const& mode : output.modes)
+    {
+        if (mode.size.width.as_int() == width &&
+            mode.size.height.as_int() == height)
+        {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+/*
+ * S9 Task12H:
+ *
+ * The static MirAL policy cannot express "use the preferred mode" without
+ * hardcoding a mode.  When an external DisplayPort is connected, normalize
+ * the nested/local configuration here:
+ *
+ *   - external DP: enabled, powered, preferred mode, origin 0,0
+ *   - internal LVDS: disabled locally so Xwayland sees only the external DP
+ *
+ * s9_host_compatible_configuration() later re-enables LVDS only in the clone
+ * sent to the host LSC/HWC, keeping Samsung's physical primary alive.
+ */
+std::size_t s9_select_external_mode(
+    mg::UserDisplayConfigurationOutput const& output)
+{
+    if (output.modes.empty())
+        return 0;
+
+    std::size_t preferred =
+        output.preferred_mode_index < output.modes.size() ?
+        output.preferred_mode_index : 0;
+
+    auto const& preferred_mode = output.modes[preferred];
+
+    /*
+     * First choice:
+     * same resolution as the host preferred mode, but refresh closest to
+     * 60 Hz.
+     */
+    std::size_t best_same_resolution = preferred;
+    double best_same_delta = 1000000.0;
+
+    for (std::size_t i = 0; i < output.modes.size(); ++i)
+    {
+        auto const& mode = output.modes[i];
+
+        if (mode.size.width != preferred_mode.size.width ||
+            mode.size.height != preferred_mode.size.height)
+        {
+            continue;
+        }
+
+        double const delta =
+            mode.vrefresh_hz >= 60.0 ?
+            mode.vrefresh_hz - 60.0 :
+            60.0 - mode.vrefresh_hz;
+
+        if (delta < best_same_delta)
+        {
+            best_same_delta = delta;
+            best_same_resolution = i;
+        }
+    }
+
+    if (best_same_delta <= 1.0)
+        return best_same_resolution;
+
+    /*
+     * Second choice:
+     * if preferred resolution has no sane ~60 Hz timing, choose the
+     * highest-resolution mode anywhere in the list within 59..61 Hz.
+     */
+    bool found_safe = false;
+    std::size_t best_safe = preferred;
+    long long best_area = -1;
+    double best_safe_delta = 1000000.0;
+
+    for (std::size_t i = 0; i < output.modes.size(); ++i)
+    {
+        auto const& mode = output.modes[i];
+
+        double const delta =
+            mode.vrefresh_hz >= 60.0 ?
+            mode.vrefresh_hz - 60.0 :
+            60.0 - mode.vrefresh_hz;
+
+        if (delta > 1.0)
+            continue;
+
+        long long const area =
+            static_cast<long long>(mode.size.width.as_int()) *
+            static_cast<long long>(mode.size.height.as_int());
+
+        if (!found_safe ||
+            area > best_area ||
+            (area == best_area && delta < best_safe_delta))
+        {
+            found_safe = true;
+            best_safe = i;
+            best_area = area;
+            best_safe_delta = delta;
+        }
+    }
+
+    if (found_safe)
+        return best_safe;
+
+    /*
+     * Last resort: trust host preferred mode.
+     */
+    return preferred;
+}
