+/*
+ * S9_CLIPBRIDGE_V1: ponte de clipboard Mir <-> processo auxiliar (lado X11).
+ *
+ * O XWM do Mir 1.8.3 nao faz ponte de selecao entre Wayland e X11 e o Xwayland
+ * rodando com -wm tambem nao. Esta classe expoe a selecao Wayland (texto) a um
+ * processo local por um socket Unix e aceita texto vindo dele.
+ *
+ * Tudo roda na thread do loop de eventos do Wayland (wl_event_loop): nao ha
+ * threads nem travas aqui.
+ *
+ * Protocolo (quadros): 1 byte de tipo + 4 bytes de tamanho (big endian) + carga.
+ *   Mir -> ponte: 'W' texto UTF-8 da selecao Wayland
+ *                 'I' imagem da selecao Wayland: "mime\0bytes" (ex.: image/png)
+ *                 'C' a selecao Wayland nao tem texto nem imagem
+ *   ponte -> Mir: 'X' texto UTF-8 da selecao CLIPBOARD do X11
+ *                 'Y' imagem da selecao CLIPBOARD do X11: "mime\0bytes"
+ *
+ * Cabecalho independente do Mir: so usa libwayland-server e a biblioteca padrao.
+ */
+#ifndef S9_CLIPBRIDGE_H_
+#define S9_CLIPBRIDGE_H_
+
+#include <wayland-server-core.h>
+
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+class S9ClipBridge
+{
+public:
+    // Deve gravar a selecao em write_fd (assume a posse do descritor e o fecha).
+    using Requester = std::function<void(std::string const& mime, int write_fd)>;
+    // kind: 'X' texto, 'Y' imagem ("mime\0bytes")
+    using ExternalData = std::function<void(char kind, std::string payload)>;
+
+    static constexpr size_t kMaxPayload = 32u * 1024u * 1024u;
+    static constexpr size_t kMaxOutBuffer = 96u * 1024u * 1024u;
+    static constexpr int kTransferTimeoutMs = 5000;
+
+    S9ClipBridge(wl_event_loop* loop, std::string const& path, uid_t allowed_uid, ExternalData on_external)
+        : loop_{loop}, path_{path}, allowed_uid_{allowed_uid}, on_external_{std::move(on_external)}
+    {
+        open_listener();
+    }
+
+    S9ClipBridge(S9ClipBridge const&) = delete;
+    S9ClipBridge& operator=(S9ClipBridge const&) = delete;
+
+    ~S9ClipBridge()
+    {
+        abort_transfer();
+        close_conn();
+        if (listener_src_) wl_event_source_remove(listener_src_);
+        if (listener_fd_ >= 0)
+        {
+            ::close(listener_fd_);
+            ::unlink(path_.c_str());
+        }
+    }
+
+    bool ok() const { return listener_fd_ >= 0; }
+    bool connected() const { return conn_fd_ >= 0; }
+
+    // O que a ponte recebeu do X11 e igual ao que o Wayland ja tem? (anti-eco)
+    bool same_as_wayland(char ext_kind, std::string const& payload) const
+    {
+        char const want = ext_kind == 'X' ? 'W' : 'I';
+        return last_kind_ == want && last_payload_ == payload;
+    }
+
+    // Um cliente Wayland acabou de definir a selecao (todos os offer ja chegaram).
+    void selection_set(std::vector<std::string> const& mimes, Requester const& request)
+    {
+        static char const* const text_prefer[] = {"text/plain;charset=utf-8", "UTF8_STRING", "text/plain"};
+        static char const* const image_prefer[] = {"image/png", "image/jpeg", "image/bmp"};
+
+        std::string chosen;
+        char kind = 0;
+        for (auto const* p : text_prefer)
+        {
+            if (std::find(mimes.begin(), mimes.end(), std::string{p}) != mimes.end())
+            {
+                chosen = p;
+                kind = 'W';
+                break;
+            }
+        }
+        if (chosen.empty())
+        {
+            for (auto const* p : image_prefer)
+            {
+                if (std::find(mimes.begin(), mimes.end(), std::string{p}) != mimes.end())
+                {
+                    chosen = p;
+                    kind = 'I';
+                    break;
+                }
+            }
+        }
+
+        abort_transfer();
+
+        if (chosen.empty())
+        {
+            last_kind_ = 0;
+            last_payload_.clear();
+            send_frame('C', std::string{});
+            return;
+        }
+
+        start_transfer(chosen, kind, request);
+    }
+
+    // O cliente limpou a selecao (set_selection sem fonte).
+    void selection_cleared()
+    {
+        abort_transfer();
+        last_kind_ = 0;
+        last_payload_.clear();
+        send_frame('C', std::string{});
+    }
+
+private:
+    struct Transfer
+    {
+        int fd = -1;
+        wl_event_source* src = nullptr;
+        wl_event_source* timer = nullptr;
+        std::string data;
+        std::string mime;
+        char kind = 'W';
+    };
+
+    // ---- listener / conexao -------------------------------------------------
+    void open_listener()
+    {
+        sockaddr_un addr;
+        std::memset(&addr, 0, sizeof addr);
+        addr.sun_family = AF_UNIX;
+        if (path_.size() >= sizeof addr.sun_path)
+        {
+            std::fprintf(stderr, "S9-CLIP: caminho do socket longo demais: %s\n", path_.c_str());
+            return;
+        }
+        std::memcpy(addr.sun_path, path_.c_str(), path_.size() + 1);
+
+        int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+        if (fd < 0)
+        {
+            std::fprintf(stderr, "S9-CLIP: socket(): %s\n", std::strerror(errno));
+            return;
+        }
+
+        ::unlink(path_.c_str());
+        if (::bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof addr) < 0 || ::listen(fd, 4) < 0)
+        {
+            std::fprintf(stderr, "S9-CLIP: nao consegui abrir %s: %s\n", path_.c_str(), std::strerror(errno));
+            ::close(fd);
+            return;
+        }
+        ::chmod(path_.c_str(), 0666);  // quem pode falar e decidido por SO_PEERCRED
+
+        listener_fd_ = fd;
+        listener_src_ = wl_event_loop_add_fd(loop_, fd, WL_EVENT_READABLE, &S9ClipBridge::on_listener, this);
+        std::fprintf(stderr, "S9-CLIP: ponte de clipboard ouvindo em %s (uid permitido %u)\n",
+                     path_.c_str(), static_cast<unsigned>(allowed_uid_));
+    }
+
+    static int on_listener(int fd, uint32_t, void* data)
+    {
+        static_cast<S9ClipBridge*>(data)->accept_conn(fd);
+        return 0;
+    }
+
+    void accept_conn(int lfd)
+    {
+        for (;;)
+        {
+            int c = ::accept4(lfd, nullptr, nullptr, SOCK_CLOEXEC | SOCK_NONBLOCK);
+            if (c < 0) return;  // EAGAIN etc.
+
+            ucred cred;
+            socklen_t len = sizeof cred;
+            if (::getsockopt(c, SOL_SOCKET, SO_PEERCRED, &cred, &len) < 0 ||
+                (cred.uid != 0 && cred.uid != allowed_uid_))
+            {
+                std::fprintf(stderr, "S9-CLIP: conexao recusada (uid %u)\n",
+                             len == sizeof cred ? static_cast<unsigned>(cred.uid) : 0u);
+                ::close(c);
+                continue;
+            }
+
+            close_conn();
+            conn_fd_ = c;
+            conn_src_ = wl_event_loop_add_fd(loop_, c, WL_EVENT_READABLE, &S9ClipBridge::on_conn, this);
+            std::fprintf(stderr, "S9-CLIP: ponte conectada (pid %d)\n", static_cast<int>(cred.pid));
+
+            if (last_kind_) send_frame(last_kind_, last_payload_);  // reenvia o que o Wayland tem agora
+        }
+    }
+
+    static int on_conn(int, uint32_t mask, void* data)
+    {
+        static_cast<S9ClipBridge*>(data)->handle_conn(mask);
+        return 0;
+    }
+
+    void handle_conn(uint32_t mask)
+    {
+        if (conn_fd_ < 0) return;
+
+        if (mask & WL_EVENT_READABLE)
+        {
+            char buf[65536];
+            for (;;)
+            {
+                ssize_t n = ::read(conn_fd_, buf, sizeof buf);
+                if (n > 0)
+                {
+                    rbuf_.append(buf, static_cast<size_t>(n));
+                    if (!parse_frames()) return;  // conexao fechada por erro de protocolo
+                    continue;
+                }
+                if (n == 0)
+                {
+                    close_conn();
+                    return;
+                }
+                if (errno == EINTR) continue;
+                if (errno != EAGAIN && errno != EWOULDBLOCK)
+                {
+                    close_conn();
+                    return;
+                }
+                break;
+            }
+        }
+
+        if ((mask & WL_EVENT_WRITABLE) && conn_fd_ >= 0) flush_out();
+        if ((mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR)) && conn_fd_ >= 0) close_conn();
+    }
+
+    bool parse_frames()
+    {
+        while (rbuf_.size() >= 5)
+        {
+            auto const* p = reinterpret_cast<unsigned char const*>(rbuf_.data());
+            size_t const len = (static_cast<size_t>(p[1]) << 24) | (static_cast<size_t>(p[2]) << 16) |
+                               (static_cast<size_t>(p[3]) << 8) | static_cast<size_t>(p[4]);
+            if (len > kMaxPayload)
+            {
+                std::fprintf(stderr, "S9-CLIP: quadro grande demais (%zu); fechando\n", len);
+                close_conn();
+                return false;
+            }
+            if (rbuf_.size() < 5 + len) break;
+
+            char const type = rbuf_[0];
+            std::string payload = rbuf_.substr(5, len);
+            rbuf_.erase(0, 5 + len);
+
+            if ((type == 'X' || type == 'Y') && on_external_) on_external_(type, std::move(payload));
+            if (conn_fd_ < 0) return false;
+        }
+        return true;
+    }
+
+    void send_frame(char type, std::string const& payload)
+    {
+        if (conn_fd_ < 0) return;
+
+        unsigned char hdr[5] = {
+            static_cast<unsigned char>(type),
+            static_cast<unsigned char>((payload.size() >> 24) & 0xff),
+            static_cast<unsigned char>((payload.size() >> 16) & 0xff),
+            static_cast<unsigned char>((payload.size() >> 8) & 0xff),
+            static_cast<unsigned char>(payload.size() & 0xff)};
+
+        if (wbuf_.size() - wpos_ + 5 + payload.size() > kMaxOutBuffer)
+        {
+            std::fprintf(stderr, "S9-CLIP: ponte lenta demais; fechando a conexao\n");
+            close_conn();
+            return;
+        }
+        wbuf_.append(reinterpret_cast<char const*>(hdr), 5);
+        wbuf_.append(payload);
+        flush_out();
+    }
+
+    void flush_out()
+    {
+        while (conn_fd_ >= 0 && wpos_ < wbuf_.size())
+        {
+            ssize_t n = ::send(conn_fd_, wbuf_.data() + wpos_, wbuf_.size() - wpos_, MSG_NOSIGNAL);
+            if (n > 0)
+            {
+                wpos_ += static_cast<size_t>(n);
+                continue;
+            }
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+            {
+                if (conn_src_) wl_event_source_fd_update(conn_src_, WL_EVENT_READABLE | WL_EVENT_WRITABLE);
+                return;
+            }
+            close_conn();
+            return;
+        }
+
+        if (conn_fd_ >= 0)
+        {
+            wbuf_.clear();
+            wpos_ = 0;
+            if (conn_src_) wl_event_source_fd_update(conn_src_, WL_EVENT_READABLE);
+        }
+    }
+
+    void close_conn()
+    {
+        if (conn_src_)
+        {
+            wl_event_source_remove(conn_src_);
+            conn_src_ = nullptr;
+        }
+        if (conn_fd_ >= 0)
+        {
+            ::close(conn_fd_);
+            conn_fd_ = -1;
+            std::fprintf(stderr, "S9-CLIP: ponte desconectada\n");
+        }
+        rbuf_.clear();
+        wbuf_.clear();
+        wpos_ = 0;
+    }
+
+    // ---- leitura da selecao Wayland ------------------------------------------
+    void start_transfer(std::string const& mime, char kind, Requester const& request)
+    {
+        int fds[2];
+        if (::pipe2(fds, O_CLOEXEC) < 0) return;
+
+        int const fl = ::fcntl(fds[0], F_GETFL);
+        ::fcntl(fds[0], F_SETFL, fl | O_NONBLOCK);  // so a ponta de leitura
+
+        xfer_.reset(new Transfer);
+        xfer_->kind = kind;
+        xfer_->mime = mime;
+        xfer_->fd = fds[0];
+        xfer_->src = wl_event_loop_add_fd(loop_, fds[0], WL_EVENT_READABLE, &S9ClipBridge::on_xfer_fd, this);
+        xfer_->timer = wl_event_loop_add_timer(loop_, &S9ClipBridge::on_xfer_timer, this);
+        wl_event_source_timer_update(xfer_->timer, kTransferTimeoutMs);
+
+        request(mime, fds[1]);  // assume a posse de fds[1]
+    }
+
+    static int on_xfer_fd(int fd, uint32_t, void* data)
+    {
+        static_cast<S9ClipBridge*>(data)->read_transfer(fd);
+        return 0;
+    }
+
+    static int on_xfer_timer(void* data)
+    {
+        auto* self = static_cast<S9ClipBridge*>(data);
+        std::fprintf(stderr, "S9-CLIP: a fonte Wayland nao respondeu a tempo; ignorando\n");
+        self->abort_transfer();
+        return 0;
+    }
+
+    void read_transfer(int fd)
+    {
+        if (!xfer_ || xfer_->fd != fd) return;
+
+        char buf[65536];
+        for (;;)
+        {
+            ssize_t n = ::read(fd, buf, sizeof buf);
+            if (n > 0)
+            {
+                xfer_->data.append(buf, static_cast<size_t>(n));
+                if (xfer_->data.size() > kMaxPayload)
+                {
+                    std::fprintf(stderr, "S9-CLIP: selecao Wayland maior que %zu bytes; ignorando\n", kMaxPayload);
+                    abort_transfer();
+                    return;
+                }
+                continue;
+            }
+            if (n == 0) break;  // EOF: terminou
+            if (errno == EINTR) continue;
+            if (errno == EAGAIN || errno == EWOULDBLOCK) return;  // espera mais
+            abort_transfer();
+            return;
+        }
+
+        char const kind = xfer_->kind;
+        std::string payload = kind == 'I' ? xfer_->mime + std::string(1, '\0') + xfer_->data : std::move(xfer_->data);
+        abort_transfer();  // fecha fontes e descritor
+        last_kind_ = kind;
+        last_payload_ = payload;
+        std::fprintf(stderr, "S9-CLIP: selecao Wayland (%s, %zu bytes) enviada a ponte%s\n",
+                     kind == 'I' ? "imagem" : "texto", payload.size(),
+                     connected() ? "" : " (sem ponte conectada; guardada)");
+        send_frame(kind, payload);
+    }
+
+    void abort_transfer()
+    {
+        if (!xfer_) return;
+        if (xfer_->src) wl_event_source_remove(xfer_->src);
+        if (xfer_->timer) wl_event_source_remove(xfer_->timer);
+        if (xfer_->fd >= 0) ::close(xfer_->fd);
+        xfer_.reset();
+    }
+
+    wl_event_loop* const loop_;
+    std::string const path_;
+    uid_t const allowed_uid_;
+    ExternalData const on_external_;
+
+    int listener_fd_ = -1;
+    wl_event_source* listener_src_ = nullptr;
+    int conn_fd_ = -1;
+    wl_event_source* conn_src_ = nullptr;
+    std::string rbuf_;
+    std::string wbuf_;
+    size_t wpos_ = 0;
+
+    std::unique_ptr<Transfer> xfer_;
+    char last_kind_ = 0;  // 'W' texto, 'I' imagem, 0 nada
+    std::string last_payload_;
+};
+
+#endif  // S9_CLIPBRIDGE_H_
