+// S9_XWAYLAND_NOTIF_V3: notificacoes X11 ficam acima do painel inferior
+namespace
+{
+std::mutex s9_notif_mutex;
+std::set<xcb_window_t> s9_notif_windows;
+
+bool s9_is_notification_window(xcb_window_t window)
+{
+    std::lock_guard<std::mutex> lock{s9_notif_mutex};
+    return s9_notif_windows.find(window) != s9_notif_windows.end();
+}
+
+// S9_XWAYLAND_NOTIF_V4: o notifyd, quando o icone ja esta em cache, manda um pedido
+// 226x76 e logo em seguida um 164x62 em (0,0) (tamanho inicial velho); o ultimo
+// vencia e a janela ficava menor que o conteudo. Para notificacoes: ignora
+// encolhimentos, mantem o canto inferior direito pedido e descarta (0,0).
+struct S9NotifState
+{
+    int type = -1;   // -1 desconhecido, 0 nao, 1 notificacao
+    int w = 0, h = 0, x = 0, y = 0;
+};
+std::map<xcb_window_t, S9NotifState> s9_notif_state;
+
+bool s9_query_notification(xcb_connection_t* c, xcb_window_t window, xcb_atom_t type_atom, xcb_atom_t notif_atom)
+{
+    bool result = false;
+    auto* const reply = xcb_get_property_reply(
+        c, xcb_get_property(c, 0, window, type_atom, XCB_ATOM_ATOM, 0, 16), nullptr);
+    if (reply)
+    {
+        if (reply->format == 32 && reply->type == XCB_ATOM_ATOM)
+        {
+            auto const* const atoms = static_cast<xcb_atom_t const*>(xcb_get_property_value(reply));
+            int const n = xcb_get_property_value_length(reply) / 4;
+            for (int i = 0; i < n; ++i)
+            {
+                if (atoms[i] == notif_atom)
+                    result = true;
+            }
+        }
+        free(reply);
+    }
+    return result;
+}
+
+// S9_V4B: antes do mapeamento o notifyd ainda nao gravou _NET_WM_WINDOW_TYPE; o
+// WM_CLASS ja existe na criacao da janela.
+bool s9_query_class_notifyd(xcb_connection_t* c, xcb_window_t window)
+{
+    bool result = false;
+    auto* const reply = xcb_get_property_reply(
+        c, xcb_get_property(c, 0, window, XCB_ATOM_WM_CLASS, XCB_ATOM_STRING, 0, 64), nullptr);
+    if (reply)
+    {
+        int const n = xcb_get_property_value_length(reply);
+        if (n > 0)
+        {
+            std::string const value(static_cast<char const*>(xcb_get_property_value(reply)), n);
+            if (value.find("xfce4-notifyd") != std::string::npos)
+                result = true;
+        }
+        free(reply);
+    }
+    return result;
+}
+
+void s9_adjust_notification_request(
+    xcb_connection_t* c, xcb_atom_t type_atom, xcb_atom_t notif_atom,
+    xcb_window_t window, bool has_surface, int surf_w, int surf_h,
+    xcb_configure_request_event_t& ev)
+{
+    std::lock_guard<std::mutex> lock{s9_notif_mutex};
+    auto& st = s9_notif_state[window];
+    if (st.type != 1)
+    {
+        bool const is_notif =
+            s9_query_class_notifyd(c, window) || s9_query_notification(c, window, type_atom, notif_atom);
+        st.type = is_notif ? 1 : (has_surface ? 0 : -1);
+        if (is_notif)
+            mir::log_warning("S9-XWNOTIF4: janela %u classificada como notificacao (antes do mapeamento: %s)",
+                             static_cast<unsigned>(window), has_surface ? "nao" : "sim");
+    }
+    if (st.type != 1)
+        return;
+
+    uint16_t const pos_bits = XCB_CONFIG_WINDOW_X | XCB_CONFIG_WINDOW_Y;
+    uint16_t const size_bits = XCB_CONFIG_WINDOW_WIDTH | XCB_CONFIG_WINDOW_HEIGHT;
+    bool const has_pos = (ev.value_mask & pos_bits) == pos_bits;
+    bool const has_size = (ev.value_mask & size_bits) == size_bits;
+
+    if (has_size)
+    {
+        int const cur_w = has_surface ? surf_w : st.w;
+        int const cur_h = has_surface ? surf_h : st.h;
+        int const req_w = ev.width;
+        int const req_h = ev.height;
+        if (cur_w > 0 && cur_h > 0 && req_w * req_h < cur_w * cur_h)
+        {
+            if (has_pos)
+            {
+                if (ev.x == 0 && ev.y == 0)
+                {
+                    if (has_surface)
+                    {
+                        ev.value_mask &= ~pos_bits;
+                    }
+                    else
+                    {
+                        ev.x = st.x;
+                        ev.y = st.y;
+                    }
+                }
+                else
+                {
+                    ev.x = ev.x + req_w - cur_w;
+                    ev.y = ev.y + req_h - cur_h;
+                }
+            }
+            ev.width = cur_w;
+            ev.height = cur_h;
+            mir::log_warning(
+                "S9-XWNOTIF4: encolhimento %dx%d -> mantido %dx%d (pos %d,%d)",
+                req_w, req_h, cur_w, cur_h, ev.x, ev.y);
+        }
+        st.w = ev.width;
+        st.h = ev.height;
+    }
+    if ((ev.value_mask & pos_bits) == pos_bits)
+    {
+        st.x = ev.x;
+        st.y = ev.y;
+    }
+}
+
+// Altura de uma janela de largura total encostada na borda inferior da raiz X11
+// (o painel do XFCE); 0 se nao houver.
+int s9_bottom_inset(xcb_connection_t* c)
+{
+    int inset = 0;
+    auto const* const screen = xcb_setup_roots_iterator(xcb_get_setup(c)).data;
+    if (!screen)
+        return 0;
+    auto* const tree = xcb_query_tree_reply(c, xcb_query_tree(c, screen->root), nullptr);
+    if (!tree)
+        return 0;
+    auto const* const kids = xcb_query_tree_children(tree);
+    int const count = xcb_query_tree_children_length(tree);
+    for (int i = 0; i < count; ++i)
+    {
+        auto* const g = xcb_get_geometry_reply(c, xcb_get_geometry(c, kids[i]), nullptr);
+        if (!g)
+            continue;
+        if (g->width >= screen->width_in_pixels &&
+            g->height > 0 && g->height <= 120 &&
+            g->y > 0 &&
+            g->y + g->height == screen->height_in_pixels &&
+            g->height > inset)
+        {
+            inset = g->height;
+        }
+        free(g);
+    }
+    free(tree);
+    return inset;
+}
